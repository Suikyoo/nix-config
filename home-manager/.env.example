# Copy to .env and fill in. The real .env is gitignored and never enters the Nix store;
# deepseek.nix sources it from ~/.profile at login. One KEY=value per line, no `export`.
# Only read while ./deepseek.nix is uncommented in home.nix.

# DeepSeek API key, used as Claude Code's ANTHROPIC_AUTH_TOKEN.
ANTHROPIC_AUTH_TOKEN=
